  @keyframes glowblink {
    0% {
      box-shadow: 0 0 10px rgba(115, 103, 240, 0.5);
    }
    50% {
      box-shadow: 0 0 20px rgba(115, 103, 240, 1);
    }
    100% {
      box-shadow: 0 0 10px rgba(115, 103, 240, 0.5);
    }
  }
  @media (max-width: 576px) { 
  #continue-btn {
    font-size: 10px;
    padding: 10px;
  }
}

@media (min-width: 768px) { 
